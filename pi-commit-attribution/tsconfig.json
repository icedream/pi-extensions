{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"maxNodeModuleJsDepth": 0
	},
	"include": [
		"index.ts",
		"config.ts",
		"git.ts",
		"hooks.ts",
		"inject.ts",
		"ledger.ts",
		"state.ts",
		"format.mjs",
		"apply.mjs",
		"config.test.ts",
		"inject.test.ts",
		"hooks.test.ts",
		"ledger.test.ts",
		"format.test.mjs",
		"farm-cli.ts",
		"delegate.ts",
		"delegate.test.ts"
	]
}
