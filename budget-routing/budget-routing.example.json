{
  "localModel": {
    "provider": "<your-local-provider-name>",
    "modelId": "<model-id>",
    "subagentRef": "<provider>/<model-id as the subagent tool expects>"
  },
  "localSubagents": ["scout", "delegate", "Plan", "Explore"],
  "thresholds": {
    "nudge": 0.7,
    "warn": 0.8,
    "prepare": 0.95,
    "divert": 1.0
  },
  "enforce": "reject",
  "advisory": {
    "models": [
      "<local-provider>/<local-model-id>",
      "<second-provider>/<model-id>",
      "<paid-provider>/<model-id>"
    ],
    "maxModels": 8
  },
  "providers": [
    {
      "provider": "github-copilot",
      "monthlyCapUsd": 150,
      "seat": { "refreshMinutes": 15, "credential": "auto" }
    },
    {
      "provider": "anthropic",
      "monthlyCapUsd": 60,
      "reset": "utc"
    },
    {
      "provider": "mistral",
      "reset": "utc"
    },
    {
      "provider": "opper",
      "monthlyCapUsd": 8,
      "reset": "utc",
      "billing": "metered",
      "balance": { "refreshMinutes": 15 }
    }
  ]
}
